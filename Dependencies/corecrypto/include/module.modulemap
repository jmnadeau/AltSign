// Ces en-têtes corecrypto définissent des structs et des fonctions CC_INLINE.
// Déclarés en `header`, clang les rattache au module CCoreCrypto ; un .m qui les
// inclut aussi textuellement (Dependencies/corecrypto/Sources/ccsrp.m) se
// retrouve alors avec deux définitions et échoue :
//
//   ccsrp.h:121:8: error: redefinition of 'ccsrp_ctx'
//   note: '...ccsrp.h' included multiple times, additional include site in
//         header from module 'CCoreCrypto'
//
// `textual header` garde le modulemap utilisable tout en laissant les includes
// se faire textuellement, une fois par TU, sous contrôle des include guards.
module CCoreCrypto [system] {
    textual header "corecrypto/ccsrp.h"
    textual header "corecrypto/ccdrbg.h"
    textual header "corecrypto/ccsrp_gp.h"
    textual header "corecrypto/ccdigest.h"
    textual header "corecrypto/ccsha2.h"
    textual header "corecrypto/ccpbkdf2.h"
    textual header "corecrypto/cchmac.h"
    textual header "corecrypto/ccaes.h"
    textual header "corecrypto/ccpad.h"
    textual header "corecrypto/ccn.h"

    export *
}
